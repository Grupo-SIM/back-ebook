generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
  CUSTOMER
}

model Admin {
  id        String   @id @default(uuid())
  adminUser User     @relation("AdminToUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String
  cpf       String?  @unique
  name      String?
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  admin Admin? @relation("AdminToUser")
  adminToken AdminToken? @relation("AdminTokenToUser")
  Image        Image[]       @relation("UserAvatars")
  favorites    Favorite[]
  cart         Cart[]
  orders       Order[]
  notifications Notification[]
  reviews      Review[]

  createdById  String?
  createdBy    User?   @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("CreatedUsers")

  booksCreated Book[] @relation("BooksCreatedByUser")

  avatarImageId String?
  avatarImage   Image? @relation("UserAvatarImage", fields: [avatarImageId], references: [id])

  @@map("users")
}

model Image {
  id        String    @id @default(uuid())
  key       String?   @unique
  url       String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  users         User[]  @relation("UserAvatars")
  avatarOf      User[]  @relation("UserAvatarImage")
  coverOfBooks  Book[]  @relation("BookCoverImage")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  color       String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("categories")
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  description   String
  price         Float
  originalPrice Float?
  category      String
  cover         String
  coverImageId String?
  coverImage   Image? @relation("BookCoverImage", fields: [coverImageId], references: [id])
  language      String?
  printLength   Int?
  publisher     String?
  publishedDate String?
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  sales         Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isFree        Boolean  @default(false)
  fileSize      String?
  downloadUrl   String?
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  readingAge    String?
  createdById String?
  createdBy   User? @relation("BooksCreatedByUser", fields: [createdById], references: [id])

  categoryRef   Category? @relation(fields: [categoryId], references: [id])
  categoryId    Int?
  favorites     Favorite[]
  cart          Cart[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@map("books")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    String?
  bookId    Int
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("favorites")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String
  bookId    Int
  quantity  Int      @default(1)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("cart")
}

model Order {
  id            Int      @id @default(autoincrement())
  userId        String
  orderNumber   String   @unique
  status        String   @default("pending") // pending, paid, cancelled, delivered
  totalAmount   Float
  subtotal      Float
  tax           Float    @default(0)
  discount      Float    @default(0)
  paymentMethod String?
  paymentStatus String   @default("pending") // pending, paid, failed
  store         String?  // Identifica a plataforma de origem (ebook, pagatg, etc.)
  shippingAddress Json?
  billingAddress  Json?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  bookId    Int
  quantity  Int
  unitPrice Float
  totalPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@map("order_items")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  action    Json?    // { label: string, onClick: string }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    String
  bookId    Int
  rating    Int      // 1 a 5 estrelas
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reviews")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  adminId   String
  type      String   // 'book_created', 'book_updated', 'book_deleted', 'sale', 'review'
  message   String
  timestamp DateTime @default(now())
  bookId    Int?
  bookTitle String?
}

model AdminToken {
  id        String   @id @default(uuid())
  adminId   String   @unique
  token     String   // Token da API DOM
  title     String?  // Título/descrição do token
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User @relation("AdminTokenToUser", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_tokens")
}
